{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/:path*",
      "destination": {
        "service": "frontend",
        "path": "/assets/:path*"
      }
    },
    {
      "source": "/css/:path*",
      "destination": {
        "service": "frontend",
        "path": "/css/:path*"
      }
    },
    {
      "source": "/js/:path*",
      "destination": {
        "service": "frontend",
        "path": "/js/:path*"
      }
    },
    {
      "source": "/images/:path*",
      "destination": {
        "service": "frontend",
        "path": "/images/:path*"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
