{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/css/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/js/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/images/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/favicon.png",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/:file(.+\\.[a-zA-Z0-9]+)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
